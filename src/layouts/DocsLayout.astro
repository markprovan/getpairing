---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_REPO } from "../consts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Present when this layout is used via an .mdx `layout:` — Astro passes the
  // page's frontmatter under this prop rather than spreading it.
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter } = Astro.props;

// Frontmatter first: when rendering an .mdx page the title arrives as
// `frontmatter.title`, NOT as a top-level prop. Reading only `Astro.props.title`
// (as this layout used to) meant every page in the site shipped the same
// `<title>Get Pairing</title>`. The direct props are the fallback, for .astro
// pages like 404 that pass them explicitly.
const title = frontmatter?.title ?? Astro.props.title;
const description =
  frontmatter?.description ?? Astro.props.description ?? SITE_DESCRIPTION;

// The home page is already called "Get Pairing" — don't render it twice.
const pageTitle = title && title !== SITE_TITLE
  ? `${title} | ${SITE_TITLE}`
  : SITE_TITLE;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="color-scheme" content="light dark" />
    <meta charset="UTF-8" />

    <!-- Set the theme before first paint to avoid a flash of the wrong theme.
         Uses the saved preference, falling back to the OS setting. Deliberately
         duplicates the logic in ThemeToggle.astro, which cannot run this early. -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const theme =
            stored ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-sans" preload />

    <ClientRouter />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <div class="docs-shell">
      <Sidebar />
      <main id="main-content">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <p>
        &copy; {year} {SITE_TITLE} · <a href={SITE_REPO}>Contribute on GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-md);
    z-index: 100;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .skip-link:focus {
    top: var(--space-sm);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .docs-shell {
    max-width: var(--width-shell);
    margin: 0 auto;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  main {
    min-width: 0;
    max-width: var(--max-width);
  }

  /* Sidebar alongside the content once there's room for both. Below this the
     shell stays stacked and the sidebar renders as a collapsible disclosure. */
  @media (min-width: 900px) {
    .docs-shell {
      flex-direction: row;
      gap: var(--space-xl);
      padding: var(--space-lg) var(--space-md);
    }
  }

  .site-footer {
    max-width: var(--width-shell);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .site-footer p {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
