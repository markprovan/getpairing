---
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const siteTitle = "Get Pairing";
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A guide to get you started, or improve your pair programming experience"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <div class="container">
      <Sidebar />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :global(body) {
    font-family: system-ui, sans-serif;
    font-weight: 400;
    line-height: 1.5;
    color: #000;
    background: #fff;
  }

  :global(h1, h2, h3, h4, h5, h6) {
    font-weight: 700;
    line-height: 1.25;
  }

  :global(h1) {
    font-size: 2rem;
    margin-top: 1rem;
  }

  :global(h2) {
    font-size: 1.5rem;
  }

  :global(h3) {
    font-size: 1.25rem;
  }

  :global(h4) {
    font-size: 1.125rem;
  }

  :global(a) {
    color: #33e;
    text-decoration: none;
  }

  :global(a:hover) {
    color: #119;
  }

  :global(pre) {
    font-family: Menlo, monospace;
    font-size: 0.875rem;
    padding: 1rem;
    color: #000;
    background: #f6f6f6;
    overflow: auto;
    border-radius: 4px;
  }

  :global(code) {
    font-family: Menlo, monospace;
    color: #119;
    font-size: 0.875rem;
  }

  :global(pre code) {
    color: inherit;
  }

  :global(table) {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
  }

  :global(th, td) {
    text-align: left;
    padding: 4px 4px 4px 0;
    border-bottom: solid #f6f6f6;
  }

  :global(th) {
    vertical-align: bottom;
    border-bottom-width: 2px;
  }

  :global(td) {
    vertical-align: top;
    border-bottom-width: 1px;
  }

  :global(hr) {
    border: 0;
    border-bottom: 1px solid #f6f6f6;
  }

  :global(img) {
    max-width: 100%;
  }

  :global(ol, ul) {
    padding-left: 1.5rem;
    margin: 0.5rem 0;
  }

  :global(li) {
    margin: 0.25rem 0;
  }

  :global(p) {
    margin: 0.75rem 0;
  }

  .container {
    display: flex;
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  main {
    flex: 1;
    min-width: 0;
    padding: 1.5rem 2rem;
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column;
    }

    main {
      padding: 1rem;
    }
  }
</style>
